    {
      "parameters": {
        "jsCode": "const newData = $('Merge Group Data').first().json;\n// We need to merge Gemini Data into newData here too, or access from prev node\nconst geminiData = $('Parse Gemini JSON').first().json;\nconst fullData = { ...newData, ...geminiData };\n\nconst history = $input.all();\n\n// Basic deduplication: Check consistent fields\n// (Sender + Amount + Receiver + Time match)\nconst isDuplicate = history.some(item => {\n    const row = item.json;\n    return row.Sender === fullData.sender &&\n           row.Receiver === fullData.receiver &&\n           String(row.Amount) === String(fullData.amount) &&\n           row.Time === fullData.time;\n});\n\nreturn [{ json: { ...fullData, is_duplicate: isDuplicate } }];"
      },
      "id": "check-duplicates",
      "name": "Detect Duplicates",
      "type": "n8n-nodes-base.code",
